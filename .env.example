# Copia este fichero a .env y rellena los valores.
# El fichero .env NO debe subirse nunca al repositorio.
#
# Si despliegas con ./deploy.sh no hace falta tocar nada a mano: el script crea
# el .env, genera los secretos y pregunta el dominio la primera vez.

# --- Base de datos ---

DB_USERNAME=nakamahub
DB_PASSWORD=

# Solo la usa el contenedor de MySQL para su usuario root.
DB_ROOT_PASSWORD=

# --- Sesiones ---

# Clave de firma de los JWT. Minimo 32 bytes o la aplicacion no arranca.
# Genera una nueva con: openssl rand -base64 48
JWT_SECRET=

# Validez del token de acceso en milisegundos (1 h)
JWT_EXPIRATION=3600000

# Validez del token de refresco en milisegundos (30 dias)
JWT_REFRESH_EXPIRATION=2592000000

# --- Dominio ---

# Dominio publico. Caddy lo usa para pedir el certificado, y el backend para
# construir los enlaces de los correos y las URL del mapa del sitio.
DOMAIN=nakamahub.example
PUBLIC_ORIGIN=https://nakamahub.example

# Origenes permitidos para CORS, separados por comas. En produccion es el mismo
# dominio publico; en desarrollo, el servidor de Angular.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Correo (opcional) ---

# Sin SMTP_HOST, la aplicacion escribe los correos en el log en lugar de
# enviarlos, lo que permite seguir los enlaces desde la consola en desarrollo.
# Acuerdate de configurar SPF y DKIM en el DNS o acabaran en spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-responder@nakamahub.example
